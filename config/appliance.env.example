# Cluster Assurance Orchestrator appliance configuration
# Copy to config/appliance.env before running Docker Compose.
# Never commit config/appliance.env with real values.

CAO_ENVIRONMENT=appliance
CAO_CONFIG_SOURCE=docker-compose
CAO_DEMO_MODE=true
CAO_TIMEZONE=Europe/Berlin

# Persisted appliance state
CAO_EVIDENCE_DIR=/data/evidence
CAO_ADMIN_DATABASE_URL=postgresql://cao:cao-local-dev-password@postgres:5432/cao
POSTGRES_PASSWORD=cao-local-dev-password

# Set these in production/lab deployments.
CAO_AUTH_SECRET=replace-with-a-long-random-secret
CAO_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Prism endpoints can be stored through the UI Connections page.
# These env vars are optional bootstrap defaults only.
CAO_PC_URL=
CAO_PC_USERNAME=
CAO_PC_PASSWORD=
CAO_PE_URL=
CAO_PE_USERNAME=
CAO_PE_PASSWORD=

# Recommended production value: strict
# Lab-only option: insecure_skip_verify
CAO_TLS_MODE=strict
CAO_CUSTOM_CA_BUNDLE=

# Execution safety
CAO_READ_ONLY_MODE=true
CAO_ENABLE_NCC=false
CAO_ENABLE_SSH=false
CAO_GLOBAL_CONCURRENCY=2
CAO_PER_CLUSTER_CONCURRENCY=1
CAO_AUDIT_RETENTION_DAYS=90
CAO_EXECUTION_RETENTION_DAYS=180
CAO_EVIDENCE_RETENTION_DAYS=30
CAO_EVIDENCE_RETENTION_MIN_RUNS=10

# Alerting remains disabled until evidence is trusted.
CAO_ENABLE_ALERTS=false
CAO_ALERT_EMAIL_TO=
CAO_ALERT_WEBHOOK_URL=

CAO_LOG_LEVEL=INFO
