# Cluster Assurance Orchestrator local lab configuration
# Copy this file to config/local.env and fill in local values.
# Never commit config/local.env or real credentials.

CAO_ENVIRONMENT=lab
CAO_DEMO_MODE=true
CAO_TIMEZONE=Europe/Berlin

# Prism Central lab endpoint
CAO_PC_URL=https://192.0.2.205:9440/
CAO_PC_USERNAME=admin
CAO_PC_PASSWORD=

# Prism Element lab endpoint
CAO_PE_URL=https://192.0.2.201:9440/
CAO_PE_USERNAME=admin
CAO_PE_PASSWORD=

# TLS policy
# Recommended production value: strict
# Lab-only option: insecure_skip_verify
CAO_TLS_MODE=strict
CAO_CUSTOM_CA_BUNDLE=

# Execution safety
CAO_READ_ONLY_MODE=true
CAO_ENABLE_NCC=false
CAO_ENABLE_SSH=false
CAO_GLOBAL_CONCURRENCY=2
CAO_PER_CLUSTER_CONCURRENCY=1

# Evidence output for local validation only
CAO_EVIDENCE_DIR=./evidence/lab

# Local admin/RBAC store
# Use a strong value for CAO_AUTH_SECRET outside disposable local testing.
CAO_ADMIN_DB_PATH=
CAO_AUTH_SECRET=dev-local-auth-secret-change-me
CAO_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

CAO_LOG_LEVEL=INFO
